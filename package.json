{
  "name": "dsh-opencode-go-strip",
  "version": "1.1.2",
  "private": true,
  "description": "Shows OpenCode Go plan usage (5-hour, weekly, monthly) in a strip below the composer",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "README.md",
    "icon.svg"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.2"
  },
  "scripts": {
    "test": "node test/guards.test.mjs && node test/host.test.mjs && node test/client.test.mjs && node test/index.test.mjs",
    "check": "node --check index.js && node --check client.js",
    "build:index": "node scripts/build-index.mjs",
    "release": "node scripts/release.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kzhw615/dsh-opencode-go-strip.git"
  },
  "homepage": "https://github.com/kzhw615/dsh-opencode-go-strip#readme",
  "bugs": {
    "url": "https://github.com/kzhw615/dsh-opencode-go-strip/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "dsh-plugin",
    "opencode",
    "quota",
    "usage"
  ]
}
